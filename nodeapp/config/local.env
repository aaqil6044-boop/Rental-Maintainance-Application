# Local development with sample data. Safe to commit: no secrets here.
# Start:  npm run start:local        (override any line at launch:  $env:PORT="9000"; npm run start:local)
NODE_ENV=development
SEED_DEV=1
PORT=8080
DATA_DIR=data
LOG_REQUESTS=1
# RATE_LIMIT=1
# SELF_REGISTRATION=0

# ---- Tuning (defaults shown; uncomment to change) ----
TIMEZONE=Asia/Kolkata
# BCRYPT_ROUNDS=10
# PASSWORD_MIN_LENGTH=8
# PAGE_SIZE_DEFAULT=100

# ---- Email: left as 'outbox', so invitation and reset emails are written to data/outbox/*.json instead of being sent. ----
# APP_URL=http://localhost:8080
# ---- Sessions: no idle timeout in development. Two-factor is available per person under Account. ----
# SESSION_IDLE_MIN=0
# ---- Monitoring: set a token (16+ characters) to try /metrics locally. ----
# METRICS_TOKEN=local-metrics-token-1234
