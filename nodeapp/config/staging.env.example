# Staging settings. Copy to config/staging.env (that copy is git-ignored) and edit.
# NO SECRETS HERE. JWT_SECRET, SETUP_KEY, GEMINI_API_KEY come from AWS Secrets Manager (AWS_SECRET_ID) or are set in the shell.
# Start:  node --env-file=config/staging.env bootstrap.js
NODE_ENV=production
PORT=8081
DATA_DIR=data-staging
TRUST_PROXY=
SELF_REGISTRATION=1
INVITE_TTL_DAYS=7
LOG_REQUESTS=1
# Where the secrets live (leave out to supply JWT_SECRET etc. in the shell instead):
# AWS_SECRET_ID=estateops/staging/app
# AWS_REGION=ap-south-1

# ---- Tuning (defaults shown; every one is optional, see .env.example for the full list) ----
TIMEZONE=Asia/Kolkata
HTTP_KEEPALIVE_MS=65000
SHUTDOWN_TIMEOUT_MS=10000
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MIN=15
RL_REGISTER_MAX=20
RL_LOGIN_MAX=60
PAGE_SIZE_MAX=200
CACHE_TTL_SCALE=1
BACKUP_DIR=backups
BACKUP_KEEP=14

# ---- Email (links in invitations, resets and confirmations). Without SMTP_HOST messages go to DATA_DIR/outbox/*.json. ----
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# MAIL_FROM=EstateOps <no-reply@yourdomain.com>
# APP_URL=https://estateops.example.com
# REQUIRE_EMAIL_VERIFICATION=1

# ---- Sessions and two-factor ----
SESSION_IDLE_MIN=120
MAX_SESSIONS=20
# MFA_REQUIRED_FOR_MANAGERS=1

# ---- Monitoring ----
LOG_FORMAT=json
# METRICS_TOKEN comes from the secret store, not from this file.

# ---- Upload malware scanning (optional) ----
# SCAN_CLAMD_HOST=127.0.0.1
# SCAN_CLAMD_PORT=3310

# ---- Retention: 0/unset = keep for ever. See: npm run retention ----
# RETENTION_REQUEST_DAYS=2555
# RETENTION_AUDIT_DAYS=2555
