# Copy to .env (or set these in your host's environment). Placeholders only - never commit real values.
#
# PRODUCTION ON AWS: do NOT put secrets here. Store JWT_SECRET, SETUP_KEY, GEMINI_API_KEY and LOADTEST_REMOTE_ACCOUNTS in
# AWS Secrets Manager and set only these two (see AWS-SECRETS.md):
# AWS_SECRET_ID=estateops/prod/app
# AWS_REGION=ap-south-1
# Values from the secret replace the secret lines below. If the secret cannot be read, the server refuses to start.
NODE_ENV=production
PORT=8080
# Required in production, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL=12h
# Where the SQLite database and uploaded files live. Back this folder up.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880
# Needed once, to create the first manager on a fresh production database. Remove it from the environment afterwards.
SETUP_KEY=
# Only if the frontend is served from a different origin.
CORS_ORIGIN=
# Set to 1 ONLY when the app sits behind a reverse proxy that terminates HTTPS and sets X-Forwarded-For.
# If the app is reachable directly, leave this empty, otherwise clients can fake their address and dodge the rate limits.
TRUST_PROXY=1
INVITE_TTL_DAYS=7
# Abuse protection on sign-up, sign-in, setup key, invitation links and password change. Default: on in production.
# RATE_LIMIT=1
# 1 (default) lets anyone sign up as a tenant. Set 0 if tenants only join by invitation: strongest protection against account pre-registration.
# SELF_REGISTRATION=0
# Interactive API docs at /docs and /openapi.json. Default: off in production.
# DOCS=1
LOG_REQUESTS=1
# Optional AI triage. Without a key the AI button reports "not configured".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000
# Development only (ignored when NODE_ENV=production):
# SEED_DEV=1
# SEED_PASSWORD=

# ---- Load testing (see LOADTEST.md). Organization admins only. ----
# Defaults: ON in development, OFF when NODE_ENV=production unless you set it to 1.
# LOADTEST_ENABLED=1
# Hard limits. A run can never exceed these, whatever the browser sends.
# LOADTEST_MAX_VUS=200
# LOADTEST_MAX_DURATION_SEC=1800
# LOADTEST_MAX_REQUESTS=500000
# LOADTEST_MAX_CREATES=2000
# A run stops itself when more than this % of requests fail (after 200 requests).
# LOADTEST_ABORT_ERROR_PCT=50
# Extra, explicitly authorised targets: name=scheme://host[:port], comma separated. No paths, no credentials.
# LOADTEST_TARGETS=staging=https://staging.example.com
# Remote targets are refused unless this is 1 AND the admin types the target name to confirm.
# LOADTEST_ALLOW_REMOTE=0
# Test accounts that already exist on the remote target (never shown in the UI or stored with results).
# LOADTEST_REMOTE_ACCOUNTS=[{"persona":"tenant","email":"...","password":"..."},{"persona":"manager",...},{"persona":"technician",...}]

# ---- Tuning (all optional; the values shown are the defaults). A value that is not a number, or is out of range, stops startup and names the variable. ----
# Dates are shown in this IANA time zone. Default: the server's own zone. In a container this is usually UTC, so set it (e.g. Asia/Kolkata).
# TIMEZONE=Asia/Kolkata
# BODY_LIMIT=100kb                 # largest JSON request body
# HTTP_KEEPALIVE_MS=65000          # keep above your load balancer's idle timeout (AWS ALB: 60 s)
# SHUTDOWN_TIMEOUT_MS=10000        # how long a stopping server lets running requests finish
# BCRYPT_ROUNDS=10                 # 4-15; each +1 doubles the time of every sign-in
# PASSWORD_MIN_LENGTH=8            # 8-64
# LOGIN_MAX_FAILURES=8             # wrong passwords per email+address before a lockout...
# LOGIN_LOCKOUT_MIN=15             # ...lasting this many minutes
# RESET_LINK_HOURS=24              # lifetime of a manager-issued password-reset link
# RL_WINDOW_MIN=15                 # rate-limit window (minutes) for the budgets below
# RL_REGISTER_MAX=20               # sign-ups per address per RL_REGISTER_WINDOW_MIN (60)
# RL_LOGIN_MAX=60                  # failed sign-ins per address per window
# RL_SETUP_MAX=10                  # failed setup-key attempts per address per window
# RL_TOKEN_MAX=30                  # failed invitation-link lookups per address per window
# RL_PASSWORD_MAX=8                # failed current-password checks per account per window
# PAGE_SIZE_DEFAULT=100            # rows per list when the caller does not say
# PAGE_SIZE_MAX=200                # largest list a caller may ask for
# MAX_AMOUNT=10000000              # largest expense or quotation amount
# MAX_ATTACHMENTS=10               # files per request
# CACHE_TTL_SCALE=1                # multiplies every response-cache lifetime (0.5 = half as long)
# INSIGHTS_WINDOW_DAYS=90          # "recurring issue" look-back
# INSIGHTS_RECURRING_MIN=2         # reports needed to call an issue recurring
# INSIGHTS_COST_FACTOR=2           # an expense above this multiple of the category average is flagged
# BACKUP_DIR=backups               # used by: npm run backup
# BACKUP_KEEP=14                   # backups kept by: npm run backup

# ---- Email (invitations, password resets, address confirmation) ----
# Without SMTP_HOST every message is written to DATA_DIR/outbox/*.json instead of being sent (nothing leaves the machine).
# MAIL_TRANSPORT=smtp              # smtp | outbox | off. Default: smtp when SMTP_HOST is set, otherwise outbox.
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com    # Amazon SES SMTP endpoint, or your own mail server
# SMTP_PORT=587
# SMTP_SECURE=0                    # 1 for an implicit-TLS port such as 465
# SMTP_USER=                       # SES SMTP user name
# SMTP_PASS=                       # keep in AWS Secrets Manager, never in a file
# MAIL_FROM=EstateOps <no-reply@yourdomain.com>    # the address must be verified with your mail provider
# APP_URL=https://estateops.example.com            # the public address of this site; used in the links inside emails (required in production when SMTP is on)
# REQUIRE_EMAIL_VERIFICATION=1     # a tenant who signed up must confirm their email before a manager can link them by email.
#                                  # Default: on in production when SMTP is configured.
# VERIFY_LINK_HOURS=48
# RL_FORGOT_MAX=10                 # forgot-password requests per address per window
# RL_FORGOT_EMAIL_MAX=3            # ...and per email address per hour

# ---- Sessions and two-factor sign-in ----
# SESSION_IDLE_MIN=120             # sign out after this many minutes of inactivity. Default: 120 in production, 0 (off) in development.
# MAX_SESSIONS=20                  # devices signed in at once per account; the oldest is signed out beyond this
# MFA_REQUIRED_FOR_MANAGERS=0      # 1 forces every manager to set up an authenticator app before using the application
# MFA_ENC_KEY=                     # key used to encrypt stored authenticator secrets. Defaults to JWT_SECRET; if you set it, keep it with the other secrets and never change it while anyone has two-factor on.
# RL_MFA_MAX=10                    # failed two-factor codes per address per window

# ---- Uploads: malware scanning (optional) ----
# Point these at a ClamAV daemon (clamd). When it is set but cannot be reached, uploads are REFUSED (fail closed).
# SCAN_CLAMD_HOST=127.0.0.1
# SCAN_CLAMD_PORT=3310
# SCAN_TIMEOUT_MS=15000
# SCAN_FAIL_OPEN=0                 # 1 accepts the upload when the scanner is unavailable (logs a warning). Not recommended.

# ---- Monitoring ----
# LOG_FORMAT=json                  # json | text. Default: json in production, text in development. JSON lines include a request id.
# METRICS_TOKEN=                   # at least 16 characters. Without it /metrics does not exist; with it, call /metrics with "Authorization: Bearer <token>".

# ---- Retention (see: npm run retention) ----
# 0 or unset = keep for ever (the default). Values in days.
# RETENTION_REQUEST_DAYS=2555      # remove closed requests (with their comments, history, expenses and files) after this long
# RETENTION_AUDIT_DAYS=2555        # remove audit entries after this long
